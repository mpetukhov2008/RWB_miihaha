    },
    {
      "method": "get",
      "path": "/applications/{id}/segments",
      "operationId": "getVideoSegments",
      "summary": "Получить отчет о временных метках обнаруженных роликов.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
