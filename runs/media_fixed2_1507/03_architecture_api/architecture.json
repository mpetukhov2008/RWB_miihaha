{
  "entities": [
    {
      "name": "Application",
      "description": "Заявка на проверку рекламной конструкции (фото или видео).",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор заявки (UUID)."
        },
        {
          "name": "type",
          "type": "string",
          "required": true,
          "description": "Тип заявки: photo | video."
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "Статус обработки: pending | processing | completed | failed."
        },
        {
          "name": "reference_file_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор эталонного макета (JPEG/PNG)."
        },
        {
          "name": "source_file_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор исходного медиафайла (фото или видео)."
        },
        {
          "name": "result_file_id",
          "type": "string",
          "required": false,
          "description": "Идентификатор итогового файла в S3 (при успешной обработке)."
        },
        {
          "name": "similarity_score",
          "type": "number",
          "required": false,
          "description": "Процент схожести с макетом (для фото)."
        },
        {
          "name": "verification_status",
          "type": "string",
          "required": false,
          "description": "Результат верификации: matches | does_not_match | low_quality."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Время создания заявки."
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "required": true,
          "description": "Время последнего обновления."
        }
      ],
      "indexes": [
        "idx_application_status",
        "idx_application_type",
        "idx_application_created_at"
      ]
    },
    {
      "name": "MediaFile",
      "description": "Медиафайл (исходный, эталонный или итоговый), хранящийся в S3.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор файла (UUID)."
        },
        {
          "name": "s3_key",
          "type": "string",
          "required": true,
          "description": "Ключ объекта в S3."
        },
        {
          "name": "file_type",
          "type": "string",
          "required": true,
          "description": "Тип файла: jpeg | png | mp4."
        },
        {
          "name": "file_role",
          "type": "string",
          "required": true,
          "description": "Роль файла: source | reference | result."
        },
        {
          "name": "size_bytes",
          "type": "integer",
          "required": true,
          "description": "Размер файла в байтах."
        },
        {
          "name": "duration_seconds",
          "type": "number",
          "required": false,
          "description": "Длительность видео в секундах (для видеофайлов)."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Время загрузки файла."
        }
      ],
      "indexes": [
        "idx_media_file_s3_key",
        "idx_media_file_role"
      ]
    },
    {
      "name": "VideoSegment",
      "description": "Обнаруженный фрагмент рекламного ролика в исходном видео.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор сегмента (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор заявки."
        },
        {
          "name": "start_time",
          "type": "number",
          "required": true,
          "description": "Начальная временная метка (секунды)."
        },
        {
          "name": "end_time",
          "type": "number",
          "required": true,
          "description": "Конечная временная метка (секунды)."
        },
        {
          "name": "confidence",
          "type": "number",
          "required": true,
          "description": "Уверенность детекции (0-1)."
        },
        {
          "name": "result_file_id",
          "type": "string",
          "required": false,
          "description": "Идентификатор вырезанного файла в S3."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Время обнаружения сегмента."
        }
      ],
      "indexes": [
        "idx_video_segment_application_id"
      ]
    },
    {
      "name": "ProcessingJob",
      "description": "Задача обработки медиафайла (фото или видео).",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор задачи (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор заявки."
        },
        {
          "name": "job_type",
          "type": "string",
          "required": true,
          "description": "Тип задачи: photo_verification | video_detection | video_cutting."
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "Статус задачи: queued | running | completed | failed."
        },
        {
          "name": "started_at",
          "type": "datetime",
          "required": false,
          "description": "Время начала обработки."
        },
        {
          "name": "completed_at",
          "type": "datetime",
          "required": false,
          "description": "Время завершения обработки."
        },
        {
          "name": "error_message",
          "type": "string",
          "required": false,
          "description": "Сообщение об ошибке (при неудаче)."
        }
      ],
      "indexes": [
        "idx_processing_job_application_id",
        "idx_processing_job_status"
      ]
    }
  ],
  "events": [
    {
      "name": "ApplicationCreated",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "type": "photo|video",
        "reference_file_id": "uuid",
        "source_file_id": "uuid",
        "created_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Создана новая заявка на обработку."
    },
    {
      "name": "PhotoVerificationCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "similarity_score": 0.0,
        "verification_status": "matches|does_not_match|low_quality",
        "result_file_id": "uuid",
        "completed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Завершена верификация фотографии."
    },
    {
      "name": "VideoDetectionCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "segments": [
          {
            "start_time": 0.0,
            "end_time": 15.0,
            "confidence": 0.0
          }
        ],
        "completed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Завершена детекция рекламных роликов в видео."
    },
    {
      "name": "VideoCuttingCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "segments": [
          {
            "segment_id": "uuid",
            "result_file_id": "uuid"
          }
        ],
        "completed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Завершена нарезка видеофайлов."
    },
    {
      "name": "ApplicationCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "status": "completed",
        "result_file_ids": [
          "uuid"
        ],
        "completed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Заявка полностью обработана, результаты сохранены в S3."
    },
    {
      "name": "ApplicationFailed",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "status": "failed",
        "error_message": "string",
        "failed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Обработка заявки завершилась ошибкой."
    }
  ],
  "operations": [
    {
      "method": "post",
      "path": "/applications",
      "operationId": "createApplication",
      "summary": "Создать заявку на обработку медиафайла.",
      "request_schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "reference_file_id": {
            "type": "string"
          },
          "source_file_id": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "reference_file_id",
          "source_file_id"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "errors": [
        "400",
        "401",
        "409"
      ],
      "auth": true,
      "tags": [
        "applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/applications/{id}",
      "operationId": "getApplication",
      "summary": "Получить статус и результаты заявки.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "similarity_score": {
            "type": "number"
          },
          "verification_status": {
            "type": "string"
          },
          "result_file_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_time": {
                  "type": "number"
                },
                "end_time": {
                  "type": "number"
                },
                "result_file_id": {
                  "type": "string"
                }
              }
            }
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/files/upload-url",
      "operationId": "getUploadUrl",
      "summary": "Получить presigned URL для загрузки медиафайла в S3.",
      "request_schema": {
        "type": "object",
        "properties": {
          "file_type": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "mp4"
            ]
          },
          "file_role": {
            "type": "string",
            "enum": [
              "source",
              "reference"
            ]
          },
          "size_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "file_type",
          "file_role",
          "size_bytes"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string"
          },
          "upload_url": {
            "type": "string"
          },
          "s3_key": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          }
        }
      },
      "errors": [
        "400",
        "401"
      ],
      "auth": true,
      "tags": [
        "files"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/files/{id}/confirm",
      "operationId": "confirmFileUpload",
      "summary": "Подтвердить успешную загрузку файла в S3.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string"
          },
          "status": {
