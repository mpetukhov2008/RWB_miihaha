{
  "entities": [
    {
      "name": "Application",
      "description": "Заявка на проверку рекламной конструкции (фото или видео).",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор заявки (UUID)."
        },
        {
          "name": "type",
          "type": "string",
          "required": true,
          "description": "Тип заявки: photo, video."
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "Статус обработки: pending, processing, completed, failed."
        },
        {
          "name": "reference_file_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор эталонного макета (ReferenceFile)."
        },
        {
          "name": "source_file_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор исходного медиафайла (MediaFile)."
        },
        {
          "name": "result_file_id",
          "type": "string",
          "required": false,
          "description": "Идентификатор итогового медиафайла (MediaFile), если применимо."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время создания заявки."
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и времени последнего обновления."
        }
      ],
      "indexes": [
        "idx_application_status",
        "idx_application_type",
        "idx_application_created_at"
      ]
    },
    {
      "name": "ReferenceFile",
      "description": "Эталонный статический макет (JPEG/PNG), используемый для сверки.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор эталонного макета (UUID)."
        },
        {
          "name": "s3_key",
          "type": "string",
          "required": true,
          "description": "Ключ файла в S3."
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": true,
          "description": "Тип MIME (image/jpeg, image/png)."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время загрузки."
        }
      ],
      "indexes": [
        "idx_reference_file_s3_key"
      ]
    },
    {
      "name": "MediaFile",
      "description": "Исходный или итоговый медиафайл (фото или видео).",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор медиафайла (UUID)."
        },
        {
          "name": "s3_key",
          "type": "string",
          "required": true,
          "description": "Ключ файла в S3."
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": true,
          "description": "Тип MIME (image/jpeg, image/png, video/mp4)."
        },
        {
          "name": "size_bytes",
          "type": "integer",
          "required": true,
          "description": "Размер файла в байтах."
        },
        {
          "name": "duration_seconds",
          "type": "number",
          "required": false,
          "description": "Длительность видео в секундах (для видеофайлов)."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время загрузки."
        }
      ],
      "indexes": [
        "idx_media_file_s3_key",
        "idx_media_file_mime_type"
      ]
    },
    {
      "name": "PhotoAnalysisResult",
      "description": "Результат анализа фотографии: качество и соответствие макету.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор результата (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор заявки (Application)."
        },
        {
          "name": "similarity_score",
          "type": "number",
          "required": true,
          "description": "Процент схожести с эталонным макетом (0-100)."
        },
        {
          "name": "quality_status",
          "type": "string",
          "required": true,
          "description": "Статус качества: low_quality, acceptable."
        },
        {
          "name": "match_status",
          "type": "string",
          "required": true,
          "description": "Статус соответствия: matches, does_not_match, low_quality."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время завершения анализа."
        }
      ],
      "indexes": [
        "idx_photo_analysis_application_id",
        "idx_photo_analysis_match_status"
      ]
    },
    {
      "name": "VideoAnalysisResult",
      "description": "Результат анализа видеопотока: временные метки обнаруженных роликов.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор результата (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор заявки (Application)."
        },
        {
          "name": "segments",
          "type": "array",
          "required": true,
          "description": "Массив обнаруженных сегментов (start_time, end_time)."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время завершения анализа."
        }
      ],
      "indexes": [
        "idx_video_analysis_application_id"
      ]
    },
    {
      "name": "VideoSegment",
      "description": "Обнаруженный сегмент рекламного ролика в исходном видео.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор сегмента (UUID)."
        },
        {
          "name": "video_analysis_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор результата видеоанализа (VideoAnalysisResult)."
        },
        {
          "name": "start_time",
          "type": "number",
          "required": true,
          "description": "Начальная временная метка в секундах."
        },
        {
          "name": "end_time",
          "type": "number",
          "required": true,
          "description": "Конечная временная метка в секундах."
        },
        {
          "name": "result_file_id",
          "type": "string",
          "required": false,
          "description": "Идентификатор вырезанного файла (MediaFile), если нарезка выполнена."
        }
      ],
      "indexes": [
        "idx_video_segment_analysis_id"
      ]
    }
  ],
  "events": [
    {
      "name": "ApplicationCreated",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "type": "photo|video",
        "reference_file_id": "uuid",
        "source_file_id": "uuid",
        "created_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Создана новая заявка на обработку медиафайла."
    },
    {
      "name": "ApplicationProcessingStarted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "started_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Начата обработка заявки."
    },
    {
      "name": "PhotoAnalysisCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "similarity_score": 0.0,
        "quality_status": "low_quality|acceptable",
        "match_status": "matches|does_not_match|low_quality",
        "completed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Завершен анализ фотографии."
    },
    {
      "name": "VideoAnalysisCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "segments": [
          {
            "start_time": 0.0,
            "end_time": 15.0
          }
        ],
        "completed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Завершен анализ видеопотока, обнаружены временные метки."
    },
    {
      "name": "VideoSegmentCut",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "segment_id": "uuid",
        "result_file_id": "uuid",
        "s3_key": "string",
        "completed_at": "datetime"
      },
      "idempotency_key": "segment_id",
      "description": "Вырезан целевой 15-секундный фрагмент видео."
    },
    {
      "name": "ApplicationCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "status": "completed",
        "result_file_id": "uuid",
        "s3_key": "string",
        "completed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Заявка успешно обработана, итоговый файл сохранен в S3."
    },
    {
      "name": "ApplicationFailed",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "status": "failed",
        "error_code": "string",
        "error_message": "string",
        "failed_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Обработка заявки завершилась ошибкой."
    }
  ],
  "operations": [
    {
      "method": "post",
      "path": "/applications",
      "operationId": "createApplication",
      "summary": "Создать заявку на обработку медиафайла (фото или видео).",
      "request_schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ],
            "description": "Тип заявки."
          },
          "reference_file_id": {
            "type": "string",
            "description": "Идентификатор эталонного макета."
          },
          "source_file_id": {
            "type": "string",
            "description": "Идентификатор исходного медиафайла."
          }
        },
        "required": [
          "type",
          "reference_file_id",
          "source_file_id"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор созданной заявки."
          },
          "status": {
            "type": "string",
            "description": "Текущий статус заявки."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Дата и время создания."
          }
        }
      },
      "errors": [
        "400",
        "401",
        "404",
        "409"
      ],
      "auth": true,
      "tags": [
        "Applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/applications/{id}",
      "operationId": "getApplication",
      "summary": "Получить статус и детали заявки.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reference_file_id": {
            "type": "string"
          },
          "source_file_id": {
            "type": "string"
          },
          "result_file_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "Applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/applications/{id}/photo-result",
      "operationId": "getPhotoAnalysisResult",
      "summary": "Получить результат анализа фотографии.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "similarity_score": {
            "type": "number",
            "description": "Процент схожести (0-100)."
          },
          "quality_status": {
            "type": "string",
            "enum": [
              "low_quality",
              "acceptable"
            ]
          },
          "match_status": {
            "type": "string",
            "enum": [
              "matches",
              "does_not_match",
              "low_quality"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "Applications",
        "PhotoAnalysis"
      ],
      "requirement_ids": [
        "FR-001"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/applications/{id}/video-result",
      "operationId": "getVideoAnalysisResult",
      "summary": "Получить результат анализа видеопотока с временными метками.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "start_time": {
                  "type": "number"
                },
                "end_time": {
                  "type": "number"
                },
                "result_file_id": {
                  "type": "string"
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "Applications",
        "VideoAnalysis"
      ],
      "requirement_ids": [
        "FR-002",
        "FR-003"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/applications/{id}/process",
      "operationId": "triggerProcessing",
      "summary": "Принудительно запустить обработку заявки.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "errors": [
        "401",
        "404",
        "409"
      ],
      "auth": true,
      "tags": [
        "Applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/files/upload-url",
      "operationId": "getUploadUrl",
      "summary": "Получить pre-signed URL для загрузки медиафайла в S3.",
      "request_schema": {
        "type": "object",
        "properties": {
          "mime_type": {
            "type": "string",
            "description": "Тип MIME файла."
          },
          "size_bytes": {
            "type": "integer",
            "description": "Размер файла в байтах."
          },
          "is_reference": {
            "type": "boolean",
            "description": "Является ли файл эталонным макетом."
          }
        },
        "required": [
          "mime_type",
          "size_bytes"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "description": "Идентификатор файла для последующей привязки."
          },
          "upload_url": {
            "type": "string",
            "description": "Pre-signed URL для загрузки."
          },
          "s3_key": {
            "type": "string",
            "description": "Ключ файла в S3."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Срок действия URL."
          }
        }
      },
      "errors": [
        "400",
        "401"
      ],
      "auth": true,
      "tags": [
        "Files"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/files/{id}/confirm-upload",
      "operationId": "confirmFileUpload",
      "summary": "Подтвердить успешную загрузку файла в S3.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "Files"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    }
  ]
}