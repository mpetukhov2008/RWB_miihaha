[
  {
    "name": "ApplicationCreated",
    "version": "1",
    "payload": {
      "application_id": "uuid",
      "type": "photo|video",
      "reference_file_id": "uuid",
      "source_file_id": "uuid",
      "created_at": "datetime"
    },
    "idempotency_key": "application_id",
    "description": "Создана новая заявка на обработку медиафайла."
  },
  {
    "name": "ApplicationProcessingStarted",
    "version": "1",
    "payload": {
      "application_id": "uuid",
      "started_at": "datetime"
    },
    "idempotency_key": "application_id",
    "description": "Начата обработка заявки."
  },
  {
    "name": "PhotoAnalysisCompleted",
    "version": "1",
    "payload": {
      "application_id": "uuid",
      "similarity_score": 0.0,
      "quality_status": "low_quality|acceptable",
      "match_status": "matches|does_not_match|low_quality",
      "completed_at": "datetime"
    },
    "idempotency_key": "application_id",
    "description": "Завершен анализ фотографии."
  },
  {
    "name": "VideoAnalysisCompleted",
    "version": "1",
    "payload": {
      "application_id": "uuid",
      "segments": [
        {
          "start_time": 0.0,
          "end_time": 15.0
        }
      ],
      "completed_at": "datetime"
    },
    "idempotency_key": "application_id",
    "description": "Завершен анализ видеопотока, обнаружены временные метки."
  },
  {
    "name": "VideoSegmentCut",
    "version": "1",
    "payload": {
      "application_id": "uuid",
      "segment_id": "uuid",
      "result_file_id": "uuid",
      "s3_key": "string",
      "completed_at": "datetime"
    },
    "idempotency_key": "segment_id",
    "description": "Вырезан целевой 15-секундный фрагмент видео."
  },
  {
    "name": "ApplicationCompleted",
    "version": "1",
    "payload": {
      "application_id": "uuid",
      "status": "completed",
      "result_file_id": "uuid",
      "s3_key": "string",
      "completed_at": "datetime"
    },
    "idempotency_key": "application_id",
    "description": "Заявка успешно обработана, итоговый файл сохранен в S3."
  },
  {
    "name": "ApplicationFailed",
    "version": "1",
    "payload": {
      "application_id": "uuid",
      "status": "failed",
      "error_code": "string",
      "error_message": "string",
      "failed_at": "datetime"
    },
    "idempotency_key": "application_id",
    "description": "Обработка заявки завершилась ошибкой."
  }
