[
  {
    "name": "GET /api/v1/zones/current",
    "method": "GET",
    "path": "/api/v1/zones/current",
    "cases": [
      {
        "title": "Водитель внутри платной зоны — возвращает зону с тарифом",
        "expected_status": 200,
        "payload": {
          "latitude": 55.7558,
          "longitude": 37.6173
        }
      },
      {
        "title": "Водитель вне платной зоны — возвращает флаг in_zone=false",
        "expected_status": 200,
        "payload": {
          "latitude": 55.0,
          "longitude": 37.0
        }
      },
      {
        "title": "Не переданы координаты — 400",
        "expected_status": 400,
        "payload": {}
      },
      {
        "title": "Нет токена — 401",
        "expected_status": 401,
        "payload": null
      }
    ]
  },
  {
    "name": "POST /api/v1/sessions",
    "method": "POST",
    "path": "/api/v1/sessions",
    "cases": [
      {
        "title": "Успешный старт сессии в платной зоне",
        "expected_status": 201,
        "payload": {
          "zone_id": "zone-1",
          "paid_minutes": 30
        }
      },
      {
        "title": "Повторный старт при активной сессии — 409",
        "expected_status": 409,
        "payload": {
          "zone_id": "zone-1",
          "paid_minutes": 30
        }
      },
      {
        "title": "Старт вне платной зоны — 422",
        "expected_status": 422,
        "payload": {
          "zone_id": "zone-1",
          "paid_minutes": 30
        }
      },
      {
        "title": "Неверный zone_id — 404",
        "expected_status": 404,
        "payload": {
          "zone_id": "unknown",
          "paid_minutes": 30
        }
      },
      {
        "title": "Нет токена — 401",
        "expected_status": 401,
        "payload": null
      }
    ]
  },
  {
    "name": "POST /api/v1/sessions/{id}/stop",
    "method": "POST",
    "path": "/api/v1/sessions/{id}/stop",
    "cases": [
      {
        "title": "Успешное завершение активной сессии",
        "expected_status": 200,
        "payload": null
      },
      {
        "title": "Завершение уже завершённой сессии — 409",
        "expected_status": 409,
        "payload": null
      },
      {
        "title": "Сессия не найдена — 404",
        "expected_status": 404,
        "payload": null
      },
      {
        "title": "Нет токена — 401",
        "expected_status": 401,
        "payload": null
      }
    ]
  },
  {
    "name": "GET /api/v1/sessions",
    "method": "GET",
    "path": "/api/v1/sessions",
    "cases": [
      {
        "title": "История сессий водителя, отсортирована по дате начала desc",
        "expected_status": 200,
        "payload": null
      },
      {
        "title": "Нет токена — 401",
        "expected_status": 401,
        "payload": null
      }
    ]
  },
  {
    "name": "GET /api/v1/sessions/{id}/payment",
    "method": "GET",
    "path": "/api/v1/sessions/{id}/payment",
    "cases": [
      {
        "title": "Платёж в статусе pending после старта",
        "expected_status": 200,
        "payload": null
      },
      {
        "title": "Платёж в статусе paid после завершения с итоговой суммой",
        "expected_status": 200,
        "payload": null
      },
      {
        "title": "Сессия не найдена — 404",
        "expected_status": 404,
        "payload": null
      }
    ]
  },
  {
    "name": "POST /api/v1/admin/zones",
    "method": "POST",
    "path": "/api/v1/admin/zones",
    "cases": [
      {
        "title": "Админ создаёт зону с тарифом",
        "expected_status": 201,
        "payload": {
          "name": "Центр",
          "rate_per_hour": 150,
          "polygon": [
            [
              55.75,
              37.61
            ],
            [
              55.76,
              37.62
            ]
          ]
        }
      },
      {
        "title": "Дубликат названия зоны — 409",
        "expected_status": 409,
        "payload": {
          "name": "Центр",
          "rate_per_hour": 150,
          "polygon": [
            [
              55.75,
              37.61
            ],
            [
              55.76,
              37.62
            ]
          ]
        }
      },
      {
        "title": "Неверный тариф (<=0) — 422",
        "expected_status": 422,
        "payload": {
          "name": "Центр",
          "rate_per_hour": 0,
          "polygon": [
            [
              55.75,
              37.61
            ],
            [
              55.76,
              37.62
            ]
          ]
        }
      },
      {
        "title": "Доступ для роли водитель — 403",
        "expected_status": 403,
        "payload": null
      },
      {
        "title": "Нет токена — 401",
        "expected_status": 401,
        "payload": null
      }
    ]
  },
  {
    "name": "PUT /api/v1/admin/zones/{id}",
    "method": "PUT",
    "path": "/api/v1/admin/zones/{id}",
    "cases": [
      {
        "title": "Админ редактирует тариф зоны",
        "expected_status": 200,
        "payload": {
          "rate_per_hour": 200
        }
      },
      {
        "title": "Зона не найдена — 404",
        "expected_status": 404,
        "payload": {
          "rate_per_hour": 200
        }
      },
      {
        "title": "Доступ для роли водитель — 403",
        "expected_status": 403,
        "payload": null
      }
    ]
  },
  {
    "name": "GET /api/v1/admin/sessions",
    "method": "GET",
    "path": "/api/v1/admin/sessions",
    "cases": [
      {
        "title": "Админ видит список активных сессий",
        "expected_status": 200,
        "payload": {
          "status": "active"
        }
      },
      {
        "title": "Админ видит историю по зоне",
        "expected_status": 200,
        "payload": {
          "zone_id": "zone-1",
          "status": "finished"
        }
      },
      {
        "title": "Доступ для роли водитель — 403",
        "expected_status": 403,
        "payload": null
      }
    ]
  },
  {
    "name": "POST /api/v1/auth/login",
    "method": "POST",
    "path": "/api/v1/auth/login",
    "cases": [
      {
        "title": "Успешная аутентификация водителя",
        "expected_status": 200,
        "payload": {
          "email": "driver@example.com",
          "password": "secret"
        }
      },
      {
        "title": "Неверный пароль — 401",
        "expected_status": 401,
        "payload": {
          "email": "driver@example.com",
          "password": "wrong"
        }
      }
    ]
  }
]