{
  "entities": [
    {
      "name": "ParkingZone",
      "description": "Платная зона",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "UUID"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "Название"
        },
        {
          "name": "tariffPerHour",
          "type": "number",
          "required": true,
          "description": "Тариф"
        }
      ],
      "indexes": [
        "name"
      ]
    },
    {
      "name": "Session",
      "description": "Парковочная сессия",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "UUID"
        },
        {
          "name": "userId",
          "type": "string",
          "required": true,
          "description": "Водитель"
        },
        {
          "name": "zoneId",
          "type": "string",
          "required": true,
          "description": "Зона"
        },
        {
          "name": "startedAt",
          "type": "datetime",
          "required": true,
          "description": "Начало"
        },
        {
          "name": "endedAt",
          "type": "datetime",
          "required": false,
          "description": "Конец"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "active/completed"
        }
      ],
      "indexes": [
        "userId",
        "status"
      ]
    },
    {
      "name": "Payment",
      "description": "Mock-платёж",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "UUID"
        },
        {
          "name": "sessionId",
          "type": "string",
          "required": true,
          "description": "Сессия"
        },
        {
          "name": "amount",
          "type": "number",
          "required": true,
          "description": "Сумма"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "pending/paid"
        }
      ],
      "indexes": [
        "sessionId"
      ]
    }
  ],
  "events": [
    {
      "name": "SessionStarted",
      "version": "1",
      "payload": {
        "sessionId": "string",
        "zoneId": "string",
        "startedAt": "datetime"
      },
      "idempotency_key": "sessionId",
      "description": "Сессия начата"
    },
    {
      "name": "SessionCompleted",
      "version": "1",
      "payload": {
        "sessionId": "string",
        "amount": "number",
        "endedAt": "datetime"
      },
      "idempotency_key": "sessionId",
      "description": "Сессия завершена"
    }
  ],
  "operations": [
    {
      "method": "get",
      "path": "/zones/{zoneId}",
      "operationId": "getZone",
      "summary": "Получить зону",
      "request_schema": null,
      "response_schema": {
        "$ref": "#/components/schemas/ParkingZone"
      },
      "errors": [
        "404"
      ],
      "auth": false,
      "tags": [
        "zones"
      ],
      "requirement_ids": [
        "FR-001"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/sessions",
      "operationId": "startSession",
      "summary": "Начать сессию",
      "request_schema": {
        "type": "object",
        "properties": {
          "zoneId": {
            "type": "string"
          }
        }
      },
      "response_schema": {
        "$ref": "#/components/schemas/Session"
      },
      "errors": [
        "400",
        "409"
      ],
      "auth": true,
      "tags": [
        "sessions"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-005"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/sessions/{sessionId}/complete",
      "operationId": "completeSession",
      "summary": "Завершить сессию",
      "request_schema": null,
      "response_schema": {
        "$ref": "#/components/schemas/Session"
      },
      "errors": [
        "404"
      ],
      "auth": true,
      "tags": [
        "sessions"
      ],
      "requirement_ids": [
        "FR-002",
        "FR-005"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/sessions",
      "operationId": "listSessions",
      "summary": "История сессий",
      "request_schema": null,
      "response_schema": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Session"
        }
      },
      "errors": [],
      "auth": true,
      "tags": [
        "sessions"
      ],
      "requirement_ids": [
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/admin/zones",
      "operationId": "createZone",
      "summary": "Создать зону",
      "request_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "response_schema": {
        "$ref": "#/components/schemas/ParkingZone"
      },
      "errors": [
        "400",
        "403"
      ],
      "auth": true,
      "tags": [
        "admin",
        "zones"
      ],
      "requirement_ids": [
        "FR-006",
        "NFR-002"
      ],
      "error_schema": "ProblemDetails"
    }
  ]
}