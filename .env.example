# --- LLM (Qwen, OpenAI-совместимый endpoint) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5-72b-instruct
LLM_JSON_MODE=1
# mock — FakeLLM без сети (демо/CI); пусто — реальный клиент
LLM_MODE=

# --- Шаблоны: backend (.NET) ---
# Строка подключения PostgreSQL (PostGIS), используется в docker-compose
DATABASE_URL=

# --- Шаблоны: infra / CI ---
# Имена переменных ниже задействуются в .gitlab-ci.yml шаблонов.
# Значения задаются ТОЛЬКО в CI variables или в окружении, не в репозитории.
GITLAB_REGISTRY_IMAGE=
