# Базовый URL OpenAI-совместимого endpoint (Qwen)
LLM_BASE_URL=https://llm.example.local/v1

# API-ключ для доступа к модели
LLM_API_KEY=

# Имя модели
LLM_MODEL=qwen2.5-72b-instruct

# 1 — использовать response_format={"type": "json_object"}, 0 — не использовать
LLM_JSON_MODE=1

# mock — использовать FakeLLM (без сети); пусто/иначе — реальный клиент
LLM_MODE=