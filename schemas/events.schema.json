{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Events",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "payload"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "payload": { "type": "object" },
          "idempotency_key": { "type": ["string", "null"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
