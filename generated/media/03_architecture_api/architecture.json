{
  "entities": [
    {
      "name": "Application",
      "description": "Заявка на проверку рекламной конструкции (фото или видео).",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор заявки (UUID)."
        },
        {
          "name": "type",
          "type": "string",
          "required": true,
          "description": "Тип заявки: photo, video."
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "Статус обработки: pending, processing, completed, failed."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время создания заявки."
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "required": false,
          "description": "Дата и времени последнего обновления."
        }
      ],
      "indexes": [
        "idx_application_status",
        "idx_application_created_at"
      ]
    },
    {
      "name": "ReferenceTemplate",
      "description": "Эталонный фотомакет (JPEG/PNG) для сверки.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор шаблона (UUID)."
        },
        {
          "name": "s3_key",
          "type": "string",
          "required": true,
          "description": "Ключ файла в S3."
        },
        {
          "name": "format",
          "type": "string",
          "required": true,
          "description": "Формат файла: JPEG, PNG."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время создания."
        }
      ],
      "indexes": [
        "idx_reference_template_s3_key"
      ]
    },
    {
      "name": "MediaFile",
      "description": "Исходный или итоговый медиафайл (фото или видео).",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор файла (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор связанной заявки."
        },
        {
          "name": "s3_key",
          "type": "string",
          "required": true,
          "description": "Ключ файла в S3."
        },
        {
          "name": "file_type",
          "type": "string",
          "required": true,
          "description": "Тип файла: source_photo, source_video, result_photo, result_video."
        },
        {
          "name": "duration_seconds",
          "type": "number",
          "required": false,
          "description": "Длительность видео в секундах (для видеофайлов)."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время загрузки."
        }
      ],
      "indexes": [
        "idx_media_file_application_id",
        "idx_media_file_s3_key"
      ]
    },
    {
      "name": "PhotoAnalysisResult",
      "description": "Результат анализа фотографии.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор результата (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор связанной заявки."
        },
        {
          "name": "similarity_score",
          "type": "number",
          "required": true,
          "description": "Процент схожести с эталоном (0-100)."
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "Статус: matches_template, does_not_match, low_quality."
        },
        {
          "name": "quality_metrics",
          "type": "object",
          "required": false,
          "description": "Метрики качества: focus, lighting, glare."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и время анализа."
        }
      ],
      "indexes": [
        "idx_photo_analysis_application_id"
      ]
    },
    {
      "name": "VideoAnalysisResult",
      "description": "Результат анализа видеопотока.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор результата (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор связанной заявки."
        },
        {
          "name": "segments",
          "type": "array",
          "required": true,
          "description": "Массив найденных сегментов с временными метками."
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "Дата и времени анализа."
        }
      ],
      "indexes": [
        "idx_video_analysis_application_id"
      ]
    },
    {
      "name": "VideoSegment",
      "description": "Найденный сегмент рекламного ролика в видео.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор сегмента (UUID)."
        },
        {
          "name": "analysis_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор связанного анализа."
        },
        {
          "name": "start_time",
          "type": "number",
          "required": true,
          "description": "Начальная временная метка (секунды)."
        },
        {
          "name": "end_time",
          "type": "number",
          "required": true,
          "description": "Конечная временная метка (секунды)."
        },
        {
          "name": "confidence",
          "type": "number",
          "required": false,
          "description": "Уверенность определения (0-1)."
        }
      ],
      "indexes": [
        "idx_video_segment_analysis_id"
      ]
    },
    {
      "name": "ProcessingJob",
      "description": "Задача обработки медиафайла.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Уникальный идентификатор задачи (UUID)."
        },
        {
          "name": "application_id",
          "type": "string",
          "required": true,
          "description": "Идентификатор связанной заявки."
        },
        {
          "name": "job_type",
          "type": "string",
          "required": true,
          "description": "Тип задачи: photo_analysis, video_analysis, video_cutting."
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "Статус: queued, running, completed, failed."
        },
        {
          "name": "started_at",
          "type": "datetime",
          "required": false,
          "description": "Дата и время начала обработки."
        },
        {
          "name": "completed_at",
          "type": "datetime",
          "required": false,
          "description": "Дата и время завершения обработки."
        },
        {
          "name": "error_message",
          "type": "string",
          "required": false,
          "description": "Сообщение об ошибке (при неудаче)."
        }
      ],
      "indexes": [
        "idx_processing_job_application_id",
        "idx_processing_job_status"
      ]
    }
  ],
  "events": [
    {
      "name": "ApplicationCreated",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "type": "photo|video",
        "created_at": "datetime"
      },
      "idempotency_key": "application_id",
      "description": "Создана новая заявка на обработку."
    },
    {
      "name": "PhotoAnalysisCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "similarity_score": 0.0,
        "status": "matches_template|does_not_match|low_quality",
        "result_s3_key": "string"
      },
      "idempotency_key": "application_id",
      "description": "Завершен анализ фотографии."
    },
    {
      "name": "VideoAnalysisCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "segments": [
          {
            "start_time": 0.0,
            "end_time": 15.0
          }
        ]
      },
      "idempotency_key": "application_id",
      "description": "Завершен анализ видеопотока."
    },
    {
      "name": "VideoCuttingCompleted",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "result_s3_key": "string",
        "segments_processed": 0
      },
      "idempotency_key": "application_id",
      "description": "Завершена нарезка видео."
    },
    {
      "name": "ProcessingFailed",
      "version": "1",
      "payload": {
        "application_id": "uuid",
        "job_type": "string",
        "error_message": "string"
      },
      "idempotency_key": "application_id",
      "description": "Ошибка при обработке."
    }
  ],
  "operations": [
    {
      "method": "post",
      "path": "/applications",
      "operationId": "createApplication",
      "summary": "Создать заявку на обработку медиафайла.",
      "request_schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "reference_template_id": {
            "type": "string"
          },
          "media_s3_key": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "reference_template_id",
          "media_s3_key"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "errors": [
        "400",
        "401",
        "409"
      ],
      "auth": true,
      "tags": [
        "Applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/applications/{applicationId}",
      "operationId": "getApplication",
      "summary": "Получить статус и результаты заявки.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "photo_result": {
            "type": "object"
          },
          "video_result": {
            "type": "object"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "Applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/applications/{applicationId}/process",
      "operationId": "triggerProcessing",
      "summary": "Запустить принудительную обработку заявки.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "errors": [
        "401",
        "404",
        "409"
      ],
      "auth": true,
      "tags": [
        "Applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/applications/{applicationId}/results",
      "operationId": "getApplicationResults",
      "summary": "Получить детальные результаты обработки.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "photo_analysis": {
            "type": "object"
          },
          "video_analysis": {
            "type": "object"
          },
          "result_files": {
            "type": "array"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "Applications"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002",
        "FR-003",
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/reference-templates",
      "operationId": "uploadReferenceTemplate",
      "summary": "Загрузить эталонный фотомакет.",
      "request_schema": {
        "type": "object",
        "properties": {
          "s3_key": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "JPEG",
              "PNG"
            ]
          }
        },
        "required": [
          "s3_key",
          "format"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          }
        }
      },
      "errors": [
        "400",
        "401"
      ],
      "auth": true,
      "tags": [
        "ReferenceTemplates"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "get",
      "path": "/reference-templates/{templateId}",
      "operationId": "getReferenceTemplate",
      "summary": "Получить информацию об эталонном макете.",
      "request_schema": null,
      "response_schema": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          },
          "s3_key": {
            "type": "string"
          },
          "format": {
            "type": "string"
          }
        }
      },
      "errors": [
        "401",
        "404"
      ],
      "auth": true,
      "tags": [
        "ReferenceTemplates"
      ],
      "requirement_ids": [
        "FR-001",
        "FR-002"
      ],
      "error_schema": "ProblemDetails"
    },
    {
      "method": "post",
      "path": "/webhooks/status",
      "operationId": "receiveStatusWebhook",
      "summary": "Принять уведомление о статусе от смежной системы.",
      "request_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "result_s3_key": {
            "type": "string"
          }
        },
        "required": [
          "application_id",
          "status"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "received": true
        }
      },
      "errors": [
        "400",
        "401"
      ],
      "auth": true,
      "tags": [
        "Webhooks"
      ],
      "requirement_ids": [
        "FR-004"
      ],
      "error_schema": "ProblemDetails"
    }
  ]
}